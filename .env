# --- Konfiguracja bazy danych ---
DB_HOST=db
DB_PORT=3306
DB_USER=sklep_user
DB_PASS=bardzo_bezpieczne_haslo_db
DB_NAME=sklep_czesci_db
DB_ROOT_PASSWORD=super_bezpieczne_haslo_root

# --- JWT ---
JWT_SECRET=TWOJ_BARDZO_SILNY_SEKRET_JWT_DOCKER_COMPOSE_ZMIEN_TO_KONIECZNIE
